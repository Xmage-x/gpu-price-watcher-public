# Copy this file to .env (gitignored) and fill in real values.
# The AstrBot plugin reads these environment variables at startup.

# Optional: pre-bind the reminder target without running /gpuwatch_bind.
# Example format: weixin_personal:FriendMessage:<YOUR_SESSION_ID>@im.wechat
GPU_WATCH_PUSH_ORIGIN=

# Optional: background watch interval in seconds (default 900 = 15 minutes).
GPU_WATCH_INTERVAL_SECONDS=900
